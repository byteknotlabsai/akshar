# Settings for the akshar server. run.sh reads this file when it starts; a variable already set in the environment
# (by systemd, say) wins over the value here. Restart the server after changing it.

# Where it listens. 0.0.0.0 is every network; 127.0.0.1 keeps it to this machine (behind a proxy, say).
AKSHAR_HOST=0.0.0.0
AKSHAR_PORT=8765

# The models to offer, comma-separated, from the .cact files in models/ (empty: all of them).
AKSHAR_MODELS=
# The model for requests that name none.
AKSHAR_DEFAULT_MODEL={{default}}
# The language flag for requests that give none: hi (Hindi and Hinglish), en (English) or auto (the model decides).
AKSHAR_DEFAULT_LANGUAGE=hi

# API keys, comma-separated. Empty: anyone who can reach the port can use the server.
AKSHAR_API_KEYS=
# Websites whose pages may call the API from the browser, e.g. https://app.example.com (comma-separated; * is any).
AKSHAR_CORS_ORIGINS=*

# Limits per request, and how many requests may wait for the engine before the server answers 503.
AKSHAR_MAX_MB=100
AKSHAR_MAX_SECONDS=600
AKSHAR_MAX_WAITING=8

# CPUs for the engine, e.g. 12-23, on a machine shared with other busy services (empty: all of them).
AKSHAR_CPUS=
